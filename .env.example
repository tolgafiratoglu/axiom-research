# AxiomResearch — project config (copy to .env in repo root).
# Secrets (GEMINI_API_KEY, Materials Project key, …) live in SECRETS_ENV_PATH.
# Do not put keys here or in images.

# --- LLM ---
LLM_PROVIDER=gemini

# Operator-chosen currently supported Gemini Flash ID (not Flash-Lite).
# Model list: https://ai.google.dev/gemini-api/docs/models
# Do not hard-code retired IDs. As of 2026-10-30 gemini-3.5-flash is
# deprecated and requests are routed to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

SECRETS_ENV_PATH=~/.config/rag/.env

# --- Compose service URLs (Docker DNS) ---
API_URL=http://api:8080
VERIFIER_URL=http://verifier:9000
MCP_LITERATURE_URL=http://mcp-literature:8080
MCP_MATERIALS_URL=http://mcp-materials:8080
MCP_RESEARCH_DATA_URL=http://mcp-research-data:8080

# Host-side WebSocket (browser → api). One socket per session; no SSE, no POST /chat.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8200/ws/session

# Host port publishes (bound to 127.0.0.1 in compose)
WEB_PORT=3200
API_PORT=8200
VERIFIER_PORT=8201
MCP_LITERATURE_PORT=8210
MCP_MATERIALS_PORT=8211
MCP_RESEARCH_DATA_PORT=8212
POSTGRES_PORT=5434

# --- Postgres ---
POSTGRES_DB=axiom_research
POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom
DATABASE_URL=postgresql://axiom:axiom@postgres:5432/axiom_research

# --- Swarm budgets (tighter than SDK defaults) ---
SWARM_MAX_HANDOFFS=8
SWARM_MAX_ITERATIONS=8
SWARM_EXECUTION_TIMEOUT_SECONDS=180
SWARM_NODE_TIMEOUT_SECONDS=45
SWARM_MAX_TOKENS_PER_RUN=100000
SWARM_MAX_COST_USD_PER_RUN=1.00
